#
# ghostty config by skaper
#

# Theme (Abernathy, Liquid Carbon Transparent, Adventure, etc.)
theme = Hardcore

# Font
font-family = JetBrains Mono
font-size = 15
foreground = 149414
#adjust-cell-width = 5%
#adjust-cell-height = 5%

# Window
window-padding-x = 15
window-padding-y = 15
window-decoration = none
maximize = true
background-opacity = 0.8
#background-blur = true

# Keybinding
keybind = ctrl+shift+x=close_surface
